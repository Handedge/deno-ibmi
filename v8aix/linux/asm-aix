#!/bin/bash
# Assembler for the AIX cross toolchain: the embedded.S produced by mksnapshot (AIX
# assembler syntax: .csect, .xline...) cannot be read by LLVM, so we reuse the
# object assembled on IBM i (gcc-12 + PASE as) dropped into ~/v8aix/sorties-ibmi.
# Any other assembly file goes through clang (integrated assembler).
src=""; out=""; prev=""
for a in "$@"; do
  [ "$prev" = "-c" ] && src="$a"
  [ "$prev" = "-o" ] && out="$a"
  prev="$a"
done
case "$src" in
  */embedded.S)
    obj="$HOME/v8aix/sorties-ibmi/embedded.o"
    if [ -f "$obj" ]; then
      cp "$obj" "$out"
      [ -n "$out" ] && : > "$out.d" 2>/dev/null
      echo "asm-aix: $src -> object assembled on IBM i ($obj)"
      exit 0
    fi
    echo "asm-aix: $obj missing (assemble embedded.S on IBM i)" >&2
    exit 1;;
esac
exec "$HOME/v8aix/clang/bin/clang" --target=powerpc64-ibm-aix7.2 -fintegrated-as "$@"
